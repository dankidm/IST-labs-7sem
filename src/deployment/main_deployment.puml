@startuml main_deployment
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
LAYOUT_WITH_LEGEND()
scale max 3800 width

title Сводная диаграмма развёртывания — ИИ-платформа базы знаний и маркетинга (L2)
' Проектная топология, не свидетельство фактического развёртывания приложения.
' Суффиксы _1/_2 обозначают экземпляры одного логического контейнера L2.
' Для компактности основные исходящие связи показаны у экземпляра 1; у экземпляра 2 они аналогичны.
' Полный перечень функциональных интеграций — main_containers.puml; внешние интеграции — main_landscape.puml.

Deployment_Node(employee_pc, "Рабочее место сотрудника", "Браузер, Windows / macOS") {
  Container(web_app, "Веб-приложение", "React 18 / TypeScript", "База знаний, поиск, материалы")
}
Deployment_Node(employee_phone, "Смартфон сотрудника", "iOS / Android") {
  Container(mobile_app, "Мобильное приложение", "React Native", "Кейсы, согласование")
}

Deployment_Node(datacenter, "ЦОД заказчика / облако", "Приватная сеть VPC или закрытый контур") {
  Deployment_Node(dmz_node, "Пограничный сервер DMZ", "Ubuntu 22.04 VM", "Единственный публичный вход: TCP 443, TLS 1.3") {
    Container(api_gateway, "API-шлюз", "Nginx 1.25", "TLS 1.3, вход 443, балансировка")
  }
  Deployment_Node(app_node_1, "Сервер приложений 1", "Ubuntu 22.04, Docker 26", "Приватная подсеть приложений") {
    Container(core_api_1, "Ядро базы знаний (экз. 1)", "FastAPI / Python 3.12", "Знания, поиск, ACL")
    Container(auth_service_1, "Авторизация (экз. 1)", "Keycloak 24", "SSO, OIDC, LDAP-федерация")
    Container(agent_service_1, "ИИ-агент (экз. 1)", "FastAPI / LangGraph", "RAG и инструменты")
    Container(generation_service_1, "Генерация материалов (экз. 1)", "FastAPI / Celery", "API заданий и воркер")
    Container(analytics_service_1, "Аналитика (экз. 1)", "FastAPI / pandas", "Показатели, отчёты")
  }
  Deployment_Node(app_node_2, "Сервер приложений 2", "Ubuntu 22.04, Docker 26", "Приватная подсеть приложений") {
    Container(core_api_2, "Ядро базы знаний (экз. 2)", "FastAPI / Python 3.12", "Знания, поиск, ACL")
    Container(auth_service_2, "Авторизация (экз. 2)", "Keycloak 24", "SSO, OIDC, LDAP-федерация")
    Container(agent_service_2, "ИИ-агент (экз. 2)", "FastAPI / LangGraph", "RAG и инструменты")
    Container(generation_service_2, "Генерация материалов (экз. 2)", "FastAPI / Celery", "API заданий и воркер")
    Container(analytics_service_2, "Аналитика (экз. 2)", "FastAPI / pandas", "Показатели, отчёты")
  }
  Deployment_Node(worker_node, "Сервер фоновых обработчиков", "Ubuntu 22.04, Docker 26") {
    Container(ingestion_service, "Обработка документов", "Celery / Docling / OCR", "Разбор и индексация")
    Container(market_collector, "Сбор рынка", "Airflow / Python", "ETL рыночных данных")
  }
  Deployment_Node(gpu_node, "GPU-сервер", "Ubuntu 22.04, NVIDIA GPU / CUDA", "Модель GPU и ресурсы требуют расчёта") {
    Container(llm_server, "Локальный LLM", "vLLM / bge-m3", "Генерация и эмбеддинги")
  }
  Deployment_Node(data_node, "Сервер хранилищ", "Ubuntu 22.04, Docker 26", "Приватная подсеть данных") {
    ContainerDb(vector_db, "Векторная БД", "Qdrant 1.x", "Эмбеддинги и ACL")
    ContainerDb(cache, "Кэш и сессии", "Redis 7", "Поиск и диалоги")
    ContainerQueue(message_broker, "Брокер сообщений", "RabbitMQ 3.13", "События и Celery")
    ContainerDb(object_storage, "Объектное хранилище", "MinIO / S3", "Документы и материалы")
  }
  Deployment_Node(db_primary, "Сервер основной БД", "PostgreSQL 16") {
    ContainerDb(database, "Основная БД", "PostgreSQL 16", "Данные сервисов, схема keycloak")
  }
  Deployment_Node(db_replica, "Сервер реплики БД", "PostgreSQL 16") {
    ContainerDb(database_replica, "Реплика БД", "PostgreSQL 16", "Горячий резерв, read-only")
  }
  Deployment_Node(analytics_node, "Аналитический сервер", "Ubuntu 22.04, ClickHouse 24") {
    ContainerDb(dwh, "Аналитическое хранилище", "ClickHouse 24", "Витрины рынка и использования")
  }
  Deployment_Node(monitoring_node, "Сервер наблюдаемости", "Ubuntu 22.04, Docker 26", "Служебный доступ из корпоративной сети") {
    Container(monitoring, "Наблюдаемость", "Prometheus / Grafana / Loki", "Метрики, логи, оповещения")
  }
}

Deployment_Node(corporate_net, "Корпоративная сеть заказчика", "LAN / VPN") {
  System_Ext(corporate_idp, "Корпоративный каталог пользователей", "Active Directory / FreeIPA")
  System_Ext(bi_platform, "BI-платформа", "Yandex DataLens / Apache Superset")
}

Rel(web_app, api_gateway, "REST-запросы и стриминг", "HTTPS/JSON, WSS, TLS 1.3, TCP 443")
Rel(mobile_app, api_gateway, "Запросы мобильного клиента", "HTTPS/JSON, WSS, TLS 1.3, TCP 443")
Rel(bi_platform, api_gateway, "Чтение витрин, read-only", "SQL over HTTPS, TLS 1.3, TCP 443")
Rel(api_gateway, core_api_1, "Балансировка", "HTTP/JSON, TCP 8000")
Rel(api_gateway, auth_service_1, "Балансировка", "HTTP/OIDC, TCP 8081")
Rel(api_gateway, agent_service_1, "Балансировка", "HTTP/JSON, TCP 8002")
Rel(api_gateway, generation_service_1, "Балансировка", "HTTP/JSON, TCP 8003")
Rel(api_gateway, analytics_service_1, "Балансировка", "HTTP/JSON, TCP 8004")
Rel(api_gateway, core_api_2, "Балансировка", "HTTP/JSON, TCP 8000")
Rel(api_gateway, auth_service_2, "Балансировка", "HTTP/OIDC, TCP 8081")
Rel(api_gateway, agent_service_2, "Балансировка", "HTTP/JSON, TCP 8002")
Rel(api_gateway, generation_service_2, "Балансировка", "HTTP/JSON, TCP 8003")
Rel(api_gateway, analytics_service_2, "Балансировка", "HTTP/JSON, TCP 8004")
Rel(api_gateway, dwh, "Проксирование BI, read-only", "HTTP, TCP 8123")
Rel(auth_service_1, database, "Схема keycloak", "SQL/TCP, TCP 5432")
Rel(auth_service_1, corporate_idp, "Федерация пользователей и групп", "LDAPS, TCP 636")
Rel(auth_service_2, database, "Схема keycloak", "SQL/TCP, TCP 5432")
Rel(auth_service_2, corporate_idp, "Федерация пользователей и групп", "LDAPS, TCP 636")
Rel(core_api_1, database, "Данные и поиск", "SQL/TCP, TCP 5432")
Rel(core_api_1, vector_db, "Поиск с ACL", "gRPC, TCP 6334")
Rel(core_api_1, cache, "Кэш поиска", "RESP/TCP, TCP 6379")
Rel(core_api_1, message_broker, "События знаний и материалов", "AMQP, TCP 5672")
Rel(agent_service_1, core_api_1, "Поиск с ACL", "HTTP/JSON, TCP 8000")
Rel(agent_service_1, analytics_service_1, "Рыночные показатели", "HTTP/JSON, TCP 8004")
Rel(agent_service_1, llm_server, "Локальная генерация", "HTTP/JSON (OpenAI API), TCP 8100")
Rel(generation_service_1, agent_service_1, "Запрос структуры и текстов", "HTTP/JSON, TCP 8002")
Rel(generation_service_1, object_storage, "Шаблоны и PPTX/DOCX/PDF", "HTTPS (S3 API), TCP 9000")
Rel(generation_service_1, message_broker, "Очередь Celery, material.generated", "AMQP, TCP 5672")
Rel(generation_service_1, database, "Задания и статусы", "SQL/TCP, TCP 5432")
Rel(ingestion_service, object_storage, "Чтение / запись файлов", "HTTPS (S3 API), TCP 9000")
Rel(ingestion_service, message_broker, "Обмен событиями", "AMQP, TCP 5672")
Rel(ingestion_service, llm_server, "Запрос модели", "HTTP/JSON (OpenAI API), TCP 8100")
Rel(market_collector, message_broker, "Обмен событиями", "AMQP, TCP 5672")
Rel(ingestion_service, vector_db, "Запись эмбеддингов", "gRPC, TCP 6334")
Rel(ingestion_service, database, "Статус индексации", "SQL/TCP, TCP 5432")
Rel(market_collector, database_replica, "Проекты, read-only", "SQL/TCP, TCP 5432")
Rel(market_collector, dwh, "Загрузка витрин", "HTTP, TCP 8123")
Rel(analytics_service_1, dwh, "Аналитические запросы", "HTTP, TCP 8123")
Rel(analytics_service_1, object_storage, "Сохранение отчётов", "HTTPS (S3 API), TCP 9000")
Rel(analytics_service_1, message_broker, "Публикация report.ready", "AMQP, TCP 5672")
Rel(database, database_replica, "Потоковая репликация WAL", "PostgreSQL streaming replication, TCP 5432")
Rel(monitoring, api_gateway, "Сбор метрик", "HTTP GET /metrics, приватная сеть")
Rel(monitoring, core_api_1, "Сбор метрик", "HTTP GET /metrics, приватная сеть")
Rel(monitoring, llm_server, "Сбор метрик", "HTTP GET /metrics, приватная сеть")
@enduml
