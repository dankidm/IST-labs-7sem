@startuml vibecoder_landscape
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()
title Диаграмма системного ландшафта (L0) — ИИ-платформа базы знаний и маркетинга (локальное представление: Vibecoder)

Person(marketer, "Маркетолог", "Ищет кейсы и данные, общается с ИИ-агентом, генерирует презентации, КП, one-pager и посты")
Person(bd_manager, "Менеджер по развитию бизнеса", "На выставках и встречах быстро находит кейсы и отправляет материалы партнёрам с телефона")
Person(marketing_head, "Руководитель маркетинга", "Согласует материалы, смотрит дашборды эффективности и рыночные дайджесты")

Enterprise_Boundary(customer_it, "ИТ-инфраструктура компании-заказчика") {
    System(kb_platform, "ИИ-платформа базы знаний и маркетинга", "Единая платформа: корпоративная база знаний о продуктах, проектах и кейсах, интеграция рыночной аналитики, ИИ-агент (RAG) и генерация маркетинговых материалов")
    System(crm_system, "CRM компании", "Битрикс24 / amoCRM. Клиенты, сделки, кейсы внедрения; сюда прикрепляются КП")
    System(corporate_idp, "Корпоративный каталог пользователей (IAM)", "Active Directory / FreeIPA. Учётные записи и группы сотрудников, SSO")
}

System_Ext(llm_provider, "Внешние ИИ-сервисы", "GigaChat API, YandexGPT API. Облачная генерация в SaaS-режиме и резерв при отказе локальной модели")
System_Ext(payment_gateway, "Платёжный шлюз ЮKassa", "Оплата SaaS-подписки, создание платежей и уведомления о статусе")
System_Ext(notification_gateway, "Сервисы доставки уведомлений", "SMTP-сервер, Telegram Bot API, FCM / APNs. Письма, сообщения и push")

Rel(marketer, kb_platform, "Ищет знания, общается с ИИ-агентом, генерирует материалы", "HTTPS/JSON, WSS")
Rel(bd_manager, kb_platform, "Ищет кейсы и материалы с телефона", "HTTPS/JSON, WSS")
Rel(marketing_head, kb_platform, "Согласует материалы, смотрит дашборды и дайджесты", "HTTPS/JSON, WSS")
Rel(kb_platform, corporate_idp, "Проверяет учётные данные, синхронизирует группы (SSO)", "LDAPS, TCP 636 / OIDC (OAuth2)")
Rel(kb_platform, crm_system, "Запрашивает сделки и кейсы, прикрепляет КП", "HTTPS/REST")
Rel(crm_system, kb_platform, "Сообщает о закрытии сделки (webhook)", "HTTPS/JSON")
Rel(kb_platform, llm_provider, "Облачная генерация и резерв; в закрытом контуре отключена", "HTTPS/REST")
Rel(kb_platform, payment_gateway, "Создаёт платёж за подписку", "HTTPS/REST")
Rel(payment_gateway, kb_platform, "Сообщает статус платежа (webhook)", "HTTPS/JSON")
Rel(kb_platform, notification_gateway, "Передаёт письма, сообщения и push", "SMTP/TLS 465, HTTPS/REST")
Rel(notification_gateway, bd_manager, "Доставляет push со ссылкой на материал", "FCM / APNs")
@enduml
